# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.key
*.p12

# Windows / editors
Thumbs.db
desktop.ini
*.swp
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: real keys never go to git.
.env*
# The template (variable names only, no values) is safe to share.
!.env.example

# Supabase CLI local state (project link, cached credentials, local stack)
supabase/.temp/
supabase/.branches/
supabase/.env
supabase/.env.*
supabase/**/*.local.*

# Claude Code: personal settings stay local; shared settings and agents are committed
.claude/settings.local.json
.claude/**/*.local.*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Bakong test QR written by npm run bakong:check
bakong-test-qr.png
